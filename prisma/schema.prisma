// Animal Farm Management System — data model.
//
// Money is stored as integer minor units (kobo/cents) in `*Cents` fields and
// formatted at the edges via `src/lib/format.ts`, never as floats — the same
// convention used across the rest of this codebase. Weights are Floats in
// kilograms; piglet birth weights and feed allocations are genuinely
// fractional, so integers would lose real information.
//
// Every top-level entity carries a `farmId`. Multi-farm support is a later
// phase of the spec, but retro-fitting a tenant key onto an already-populated
// schema is the single most expensive migration a system like this can be
// asked to do, so the column exists from day one and every query scopes by it
// (see src/lib/active-farm.ts). A single-farm install simply has one Farm row.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Mirrors the permission levels in the spec (§9.3). VETERINARIAN is scoped to
/// health/reproductive data; WORKER is data-entry only.
enum Role {
  ADMIN
  MANAGER
  VETERINARIAN
  WORKER
}

enum Sex {
  MALE
  FEMALE
}

/// How a species is counted on the farm.
///
/// The distinction is not cosmetic: you name and pedigree a sow, but nobody
/// names broiler #4,127. Forcing 500 birds into 500 individual rows would be
/// possible and operationally useless — mortality, feed and revenue for a
/// flock are group facts, and the screens that read them are different screens.
enum TrackingMode {
  /// Named, pedigreed, weighed individually — pigs, goats, sheep, cattle.
  INDIVIDUAL
  /// Stocked and sold as a group — poultry, catfish, snails.
  BATCH
  /// Breeding stock tracked individually, growers as groups — rabbits,
  /// grasscutters, where does are named but fryers are counted.
  HYBRID
}

/// Whether a species is farmed for output or kept to do a job.
enum SpeciesPurpose {
  /// Raised for meat, milk, eggs or breeding stock. Appears in production and
  /// profitability reporting.
  LIVESTOCK
  /// Guard and working animals. Health and vaccination records matter, but
  /// they are never sold, never enter the food chain, and must never appear in
  /// cost-per-kg-of-gain — a dog in a production report is a bug.
  WORKING
}

enum BatchStatus {
  ACTIVE
  SOLD
  CLOSED
}

enum BatchEventType {
  /// Birds, fingerlings or snails placed into the batch.
  STOCKED
  MORTALITY
  CULL
  /// Moved out to another batch or pen.
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  /// A weight sample taken across part of the batch.
  WEIGHT_SAMPLE
}

/// What a batch produces on an ongoing basis, as opposed to at slaughter.
enum BatchProductionType {
  EGGS
  MILK
  /// Snail slime, wool, and anything else measured per collection.
  OTHER
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  CULLED
  RETIRED
}

enum AcquisitionType {
  BORN_ON_FARM
  PURCHASED
}

enum ExitReason {
  SOLD
  DIED
  CULLED
  SLAUGHTERED
  BREEDING_RETIREMENT
}

enum HousingType {
  FARROWING
  GESTATION
  BREEDING
  NURSERY
  GROWER
  FINISHER
  BREEDING_MALE
  ISOLATION
  QUARANTINE
}

/// Derived from age/sex/parity at read time (see src/lib/life-stage.ts) but
/// also stored on feeding programs and vaccination protocol rows, which target
/// a stage rather than an individual animal.
enum LifeStage {
  YOUNG
  WEANER
  GROWER
  FINISHER
  MAIDEN_FEMALE
  BREEDING_FEMALE
  BREEDING_MALE
}

enum BreedingMethod {
  NATURAL
  ARTIFICIAL_INSEMINATION
}

enum PregnancyStatus {
  PENDING
  CONFIRMED
  NOT_PREGNANT
  FAILED
  FARROWED
  ABORTED
}

enum ConfirmationMethod {
  ULTRASOUND
  BEHAVIORAL
  BLOOD_TEST
  VISUAL
}

enum HealthRecordType {
  ILLNESS
  INJURY
  VACCINATION
  TREATMENT
  EXAM
}

enum HealthCategory {
  REPRODUCTIVE
  RESPIRATORY
  DIGESTIVE
  MUSCULOSKELETAL
  SKIN
  PARASITIC
  METABOLIC
  BEHAVIORAL
  OTHER
}

enum Severity {
  MILD
  MODERATE
  SEVERE
}

enum HealthOutcome {
  RECOVERED
  ONGOING
  DEATH
}

enum MedicationRoute {
  ORAL
  INJECTION
  FEED
  TOPICAL
}

enum FeedClassification {
  STARTER
  WEANER
  GROWER
  FINISHER
  GESTATION
  LACTATION
  BREEDING_MALE
  SUPPLEMENT
}

enum TransactionDirection {
  INCOME
  EXPENSE
}

/// One flat category list across both directions (§3.4). The direction field
/// says which side of the P&L a row lands on; splitting into two enums would
/// make the ledger queries awkward for no gain.
enum TransactionCategory {
  FEED
  VETERINARY
  LABOR
  HOUSING
  UTILITIES
  BEDDING
  EQUIPMENT
  BREEDING
  TRANSPORT
  MARKETING
  OTHER_EXPENSE
  YOUNG_STOCK_SALE
  FINISHED_PIG_SALE
  CULL_SALE
  BREEDING_STOCK_SALE
  SERVICE_INCOME
  OTHER_INCOME
}

enum AnimalSaleType {
  FEEDER
  FINISHED_PIG
  BREEDING_STOCK
  CULL
}

enum EquipmentStatus {
  IN_SERVICE
  NEEDS_REPAIR
  RETIRED
}

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  INSPECTION
}

enum PenTaskType {
  CLEANING
  DISINFECTION
  REPAIR
}

/// How the breeding engine treats a half-sibling pairing (§4.3 "soft
/// constraints"). Farm-configurable because the right answer depends on how
/// much genetic material the farm can actually source.
enum HalfSibPolicy {
  ALLOW
  WARN
  BLOCK
}

/// Where a farm stands with its subscription.
///
/// Billing happens on the web, never in the mobile apps: both stores take a
/// cut of in-app digital subscriptions, which on a deliberately low price for
/// smallholders is most of the margin. Both stores permit an account bought
/// elsewhere being *used* in the app — what they forbid is selling or linking
/// to the sale from inside it. So this column is written by the web checkout
/// and only ever read by the apps.
enum SubscriptionStatus {
  /// Launch state. The app ships free on both stores while the farmer base
  /// is built; pricing comes later. Modelled explicitly rather than as an
  /// endless trial, because "free plan" and "trial that never expires" read
  /// the same in the database and mean different things to the person.
  FREE
  TRIALING
  ACTIVE
  /// Payment failed. Still readable — locking a farmer out of their own
  /// animal records over a failed card is both a support nightmare and the
  /// wrong thing to do to someone whose livestock health history is in here.
  PAST_DUE
  CANCELED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ---------------------------------------------------------------------------
// Farm, users, settings
// ---------------------------------------------------------------------------

model Farm {
  species   Species[]
  batches   AnimalBatch[]
  id        String        @id @default(cuid())
  name      String        @unique
  location  String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  settings FarmSettings?

  profiles             Profile[]
  animals              Animal[]
  pens                 Pen[]
  breedingRecords      BreedingRecord[]
  healthRecords        HealthRecord[]
  vaccinationProtocols VaccinationProtocolItem[]
  feedTypes            FeedType[]
  feedStorageLocations FeedStorageLocation[]
  feedingPrograms      FeedingProgram[]
  feedingRecords       FeedingRecord[]
  suppliers            Supplier[]
  transactions         FinancialTransaction[]
  animalSales          AnimalSale[]
  equipment            Equipment[]
  alertAcks            AlertAcknowledgement[]
  invites              FarmInvite[]
  auditLogs            AuditLog[]
}

/// Farm-configurable thresholds. The spec calls these out explicitly as
/// user-configurable (§4.3) rather than constants, because the acceptable
/// inbreeding level and sire workload depend on how big and how isolated the
/// herd is. Defaults are the spec's own suggested values, with the gestation
/// length corrected to the biological figure (see `gestationDays`).
model FarmSettings {
  id     String @id @default(cuid())
  farmId String @unique
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  currency     String @default("NGN")
  currencyCode String @default("NGN")

  /// Wright's coefficient of inbreeding, as a fraction. Above this a proposed
  /// mating is rejected outright by the match finder. Spec suggests 0.10.
  maxInbreedingCoefficient  Float         @default(0.10)
  /// Below the max but above this, a mating is allowed with a warning.
  warnInbreedingCoefficient Float         @default(0.05)
  halfSibPolicy             HalfSibPolicy @default(WARN)
  /// Genetic-bottleneck guard (§4.3): how many times one boar may be used in a
  /// rolling 12 months before the match finder starts penalising him.
  maxSireUsesPerYear        Int           @default(20)

  /// Gestation length in days. The requirements document says farrowing is
  /// "~21 days after breeding" (§3.1, §8.2) — that is the length of the ESTRUS
  /// cycle, not gestation. Sow gestation is ~114 days (the "3 months, 3 weeks,
  /// 3 days" rule of thumb), so that is what is used to project farrowing
  /// dates and to flag overdue sows. Left configurable rather than hard-coded.
  gestationDays            Int   @default(114)
  gestationToleranceDays   Int   @default(3)
  /// Length of the estrus cycle — used to predict the next heat window.
  estrusCycleDays          Int   @default(21)
  weaningAgeDays           Int   @default(28)
  minBreedingAgeDaysFemale Int   @default(240)
  minBreedingAgeDaysMale   Int   @default(240)
  minBreedingWeightKg      Float @default(120)

  /// Disease-cluster alert (§3.2): N or more animals with the same condition
  /// inside the window raises an outbreak alert.
  outbreakCaseThreshold Int @default(3)
  outbreakWindowDays    Int @default(7)

  updatedAt DateTime @updatedAt
}

/// Mirrors the Supabase auth user (`Profile.id` IS the Supabase user id).
/// Auth lives in Supabase; everything role- and farm-related lives here.
model Profile {
  batchEvents     BatchEvent[]            @relation("BatchEventCreatedBy")
  batchProduction BatchProductionRecord[] @relation("BatchProductionCreatedBy")
  id              String                  @id
  email           String
  name            String
  role            Role                    @default(WORKER)
  farmId          String?
  farm            Farm?                   @relation(fields: [farmId], references: [id], onDelete: SetNull)
  approved        Boolean                 @default(false)
  createdAt       DateTime                @default(now())

  // Audit-attribution back-relations. Each model below has a single FK to
  // Profile, so each needs exactly one named relation here.
  weightRecords      WeightRecord[]         @relation("WeightRecordRecordedBy")
  penMovements       PenMovement[]          @relation("PenMovementMovedBy")
  penTasks           PenTask[]              @relation("PenTaskPerformedBy")
  breedingRecords    BreedingRecord[]       @relation("BreedingRecordCreatedBy")
  litters            Litter[]               @relation("LitterCreatedBy")
  estrusRecords      EstrusRecord[]         @relation("EstrusRecordCreatedBy")
  healthRecords      HealthRecord[]         @relation("HealthRecordCreatedBy")
  vaccinationRecords VaccinationRecord[]    @relation("VaccinationRecordCreatedBy")
  feedBatches        FeedBatch[]            @relation("FeedBatchReceivedBy")
  feedingRecords     FeedingRecord[]        @relation("FeedingRecordRecordedBy")
  transactions       FinancialTransaction[] @relation("TransactionCreatedBy")
  animalSales        AnimalSale[]           @relation("AnimalSaleCreatedBy")
  maintenanceRecords MaintenanceRecord[]    @relation("MaintenanceRecordCreatedBy")
  alertAcks          AlertAcknowledgement[] @relation("AlertAckBy")
  invitesCreated     FarmInvite[]           @relation("FarmInviteCreatedBy")
  auditLogs          AuditLog[]             @relation("AuditLogActor")

  @@index([farmId])
}

// ---------------------------------------------------------------------------
// Animals
// ---------------------------------------------------------------------------

model Animal {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  speciesId String
  species   Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  /// Ear-tag / visible identifier. Unique per farm, not globally — two farms
  /// numbering their animals from 1 is entirely normal.
  tagNumber   String
  name        String?
  breed       String
  dateOfBirth DateTime
  sex         Sex
  status      AnimalStatus @default(ACTIVE)

  // --- Pedigree ---------------------------------------------------------
  motherId          String?
  mother            Animal?  @relation("AnimalMother", fields: [motherId], references: [id], onDelete: SetNull)
  offspringAsMother Animal[] @relation("AnimalMother")
  fatherId          String?
  father            Animal?  @relation("AnimalFather", fields: [fatherId], references: [id], onDelete: SetNull)
  offspringAsFather Animal[] @relation("AnimalFather")

  /// 0 for founder animals (no recorded parents), otherwise 1 + max(parents).
  /// Denormalised on write so generation-depth reporting doesn't have to walk
  /// the whole tree for every animal.
  generation Int @default(0)

  /// Wright's coefficient of inbreeding for this animal, cached from
  /// src/lib/breeding/inbreeding.ts. Null means "not yet computed"; it is
  /// recomputed whenever the animal's ancestry changes.
  inbreedingCoefficient Float?

  litterId      String?
  litter        Litter? @relation(fields: [litterId], references: [id], onDelete: SetNull)
  birthWeightKg Float?
  markings      String?

  // --- Housing ----------------------------------------------------------
  penId       String?
  pen         Pen?      @relation(fields: [penId], references: [id], onDelete: SetNull)
  dateMovedIn DateTime?

  // --- Physical traits (drive phenotype scoring in the match finder) -----
  currentWeightKg    Float?
  bodyConditionScore Int?
  congenitalDefects  String?
  phenotypeNotes     String?

  // --- Lifecycle --------------------------------------------------------
  acquisitionType      AcquisitionType @default(BORN_ON_FARM)
  dateAcquired         DateTime
  acquisitionCostCents Int?
  dateExit             DateTime?
  exitReason           ExitReason?
  exitNotes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weightRecords      WeightRecord[]
  penMovements       PenMovement[]
  healthRecords      HealthRecord[]
  vaccinationRecords VaccinationRecord[]
  breedingsAsDam     BreedingRecord[]       @relation("BreedingDam")
  breedingsAsSire    BreedingRecord[]       @relation("BreedingSire")
  estrusRecords      EstrusRecord[]
  feedingRecords     FeedingRecord[]
  saleItems          AnimalSaleItem[]
  transactions       FinancialTransaction[]

  @@unique([farmId, tagNumber])
  @@index([speciesId, status])
  @@index([farmId, status])
  @@index([motherId])
  @@index([fatherId])
  @@index([penId])
  @@index([farmId, sex, status])
  @@index([dateOfBirth])
}

/// Weigh-in history. `Animal.currentWeightKg` is the latest of these, denormalised
/// for list views; this table is what ADG and growth curves are computed from.
model WeightRecord {
  id       String @id @default(cuid())
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  recordedAt         DateTime
  weightKg           Float
  bodyConditionScore Int?
  notes              String?

  recordedByProfileId String?
  recordedBy          Profile? @relation("WeightRecordRecordedBy", fields: [recordedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([animalId, recordedAt])
}

// ---------------------------------------------------------------------------
// Housing
// ---------------------------------------------------------------------------

model Pen {
  batches AnimalBatch[]
  id      String        @id @default(cuid())
  farmId  String
  farm    Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name        String
  housingType HousingType
  capacity    Int
  location    String?
  notes       String?
  isActive    Boolean     @default(true)

  createdAt DateTime @default(now())

  animals        Animal[]
  movements      PenMovement[]
  tasks          PenTask[]
  feedingRecords FeedingRecord[]

  @@unique([farmId, name])
  @@index([farmId, housingType])
}

/// Occupancy history. Written on every move so pen-level exposure can be
/// reconstructed for biosecurity/contact-tracing after a disease event.
model PenMovement {
  id       String @id @default(cuid())
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  penId       String?
  pen         Pen?    @relation(fields: [penId], references: [id], onDelete: SetNull)
  /// Denormalised so history survives a pen being deleted.
  fromPenName String?
  toPenName   String?

  movedAt DateTime
  reason  String?

  movedByProfileId String?
  movedBy          Profile? @relation("PenMovementMovedBy", fields: [movedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([animalId, movedAt])
  @@index([penId, movedAt])
}

/// Cleaning / disinfection / repair log, kept for biosecurity records (§3.5).
model PenTask {
  id    String @id @default(cuid())
  penId String
  pen   Pen    @relation(fields: [penId], references: [id], onDelete: Cascade)

  taskType    PenTaskType
  performedAt DateTime
  notes       String?
  costCents   Int?
  nextDueAt   DateTime?

  performedByProfileId String?
  performedBy          Profile? @relation("PenTaskPerformedBy", fields: [performedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([penId, performedAt])
}

// ---------------------------------------------------------------------------
// Breeding & reproduction
// ---------------------------------------------------------------------------

model BreedingRecord {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  damId  String
  dam    Animal @relation("BreedingDam", fields: [damId], references: [id], onDelete: Cascade)
  sireId String
  sire   Animal @relation("BreedingSire", fields: [sireId], references: [id], onDelete: Cascade)

  breedingDate DateTime
  method       BreedingMethod @default(NATURAL)

  /// breedingDate + FarmSettings.gestationDays, stored rather than derived so
  /// the calendar keeps showing the date that was projected at mating time
  /// even if the farm later changes its gestation setting.
  expectedFarrowingDate DateTime

  pregnancyStatus        PregnancyStatus     @default(PENDING)
  confirmationMethod     ConfirmationMethod?
  confirmationDate       DateTime?
  expectedOffspringCount Int?
  abnormalitiesNoted     String?

  /// Wright's F of the *hypothetical offspring* of this pairing, captured at
  /// the moment of mating. Kept as a historical record: it is what the decision
  /// was made on, and recomputing it later would give a different number as
  /// more ancestry is entered.
  offspringInbreedingCoefficient Float?
  /// Free-text record of any override — e.g. a half-sib pairing accepted
  /// deliberately because no unrelated boar was available.
  overrideReason                 String?

  notes String?

  createdByProfileId String?
  createdBy          Profile? @relation("BreedingRecordCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  litter Litter?

  @@index([farmId, breedingDate])
  @@index([damId, breedingDate])
  @@index([sireId, breedingDate])
  @@index([farmId, pregnancyStatus])
}

/// The farrowing event and its outcome. One per BreedingRecord that reaches
/// term. Individual offspring are `Animal` rows pointing back here via
/// `Animal.litterId` — a piglet is an animal from birth, not a separate entity
/// that later gets promoted, which is what keeps pedigree continuous.
model Litter {
  id               String         @id @default(cuid())
  breedingRecordId String         @unique
  breedingRecord   BreedingRecord @relation(fields: [breedingRecordId], references: [id], onDelete: Cascade)

  farrowingDate            DateTime
  farrowingDurationMinutes Int?
  bornAlive                Int
  stillborn                Int      @default(0)
  mummified                Int      @default(0)

  complications           String?
  vetInterventionRequired Boolean @default(false)
  colostrumIntakeObserved Boolean @default(false)
  postFarrowingCheckNotes String?

  weaningDate DateTime?
  weanedCount Int?
  notes       String?

  createdByProfileId String?
  createdBy          Profile? @relation("LitterCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offspring Animal[]

  @@index([farrowingDate])
}

/// Heat detection log (§2.5). Drives "sow not cycling" alerts and the next
/// breeding-opportunity window.
model EstrusRecord {
  id    String @id @default(cuid())
  sowId String
  sow   Animal @relation(fields: [sowId], references: [id], onDelete: Cascade)

  observedAt DateTime

  signRestlessness Boolean @default(false)
  signSwollenVulva Boolean @default(false)
  signDischarge    Boolean @default(false)
  signReceptive    Boolean @default(false)

  durationHours Int?
  wasBred       Boolean @default(false)
  notes         String?

  createdByProfileId String?
  createdBy          Profile? @relation("EstrusRecordCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([sowId, observedAt])
}

// ---------------------------------------------------------------------------
// Health
// ---------------------------------------------------------------------------

model HealthRecord {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  /// Exactly one of animalId or batchId is set: a treatment is given either to
  /// a named animal or to a whole flock. Both null would be an orphan record;
  /// both set would make "which animals were treated" unanswerable.
  animalId String?
  animal   Animal?      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  batchId  String?
  batch    AnimalBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  recordedAt DateTime
  recordType HealthRecordType
  category   HealthCategory
  severity   Severity         @default(MILD)

  /// Free text, but normalised through a shared suggestion list so the
  /// outbreak detector can cluster on it (see src/lib/health/conditions.ts).
  diagnosis  String
  treatment  String?
  vetNotes   String?
  costCents  Int           @default(0)
  outcome    HealthOutcome @default(ONGOING)
  resolvedAt DateTime?

  createdByProfileId String?
  createdBy          Profile? @relation("HealthRecordCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medications Medication[]

  @@index([farmId, recordedAt])
  @@index([animalId, recordedAt])
  @@index([batchId, recordedAt])
  @@index([farmId, category, recordedAt])
  @@index([farmId, diagnosis, recordedAt])
}

/// A drug administered as part of a health record. `withdrawalDays` is the
/// food-safety critical field: an animal may not be sold or slaughtered until
/// the withdrawal window after the last dose has elapsed (§8.3), which the sale
/// flow enforces rather than merely displaying.
model Medication {
  id             String       @id @default(cuid())
  healthRecordId String
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)

  drugName       String
  dosage         String?
  route          MedicationRoute @default(ORAL)
  startDate      DateTime
  durationDays   Int?
  completedDate  DateTime?
  withdrawalDays Int             @default(0)
  /// Flagged separately so antibiotic-usage reporting (a resistance-monitoring
  /// requirement in §3.2) doesn't depend on string-matching drug names.
  isAntibiotic   Boolean         @default(false)
  costCents      Int             @default(0)
  notes          String?

  createdAt DateTime @default(now())

  @@index([healthRecordId])
  @@index([drugName])
}

/// The farm's standing vaccination protocol — the schedule template, not the
/// events. Each row says "animals at this stage/age get this vaccine".
model VaccinationProtocolItem {
  /// Null means the protocol applies to every species on the farm.
  speciesId String?
  species   Species? @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name                String
  vaccineName         String
  targetStage         LifeStage
  /// Age window in days at which the dose is due. For adult boosters, use
  /// `boosterIntervalDays` instead and leave these null.
  ageDaysMin          Int?
  ageDaysMax          Int?
  boosterIntervalDays Int?
  notes               String?
  isActive            Boolean   @default(true)

  createdAt DateTime @default(now())

  records VaccinationRecord[]

  @@index([farmId, targetStage])
}

model VaccinationRecord {
  id       String @id @default(cuid())
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  protocolItemId String?
  protocolItem   VaccinationProtocolItem? @relation(fields: [protocolItemId], references: [id], onDelete: SetNull)

  vaccineName    String
  administeredAt DateTime
  /// Kept for recall traceability (§3.2).
  lotNumber      String?
  veterinarian   String?
  nextDueDate    DateTime?
  costCents      Int       @default(0)
  notes          String?

  createdByProfileId String?
  createdBy          Profile? @relation("VaccinationRecordCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([animalId, administeredAt])
  @@index([nextDueDate])
  @@index([lotNumber])
}

// ---------------------------------------------------------------------------
// Feed & nutrition
// ---------------------------------------------------------------------------

model Supplier {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name     String
  contact  String?
  phone    String?
  address  String?
  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  feedTypes   FeedType[]
  feedBatches FeedBatch[]

  @@unique([farmId, name])
}

/// A feed product the farm buys, with its nutritional profile. Stock lives in
/// `FeedBatch` rather than here: a "current quantity" column on the product
/// makes lot traceability — knowing which animals ate which delivery —
/// impossible, and that traceability is a hard requirement for recalls (§3.3).
model FeedType {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name           String
  classification FeedClassification
  description    String?

  proteinPct    Float?
  fatPct        Float?
  fiberPct      Float?
  calciumPct    Float?
  phosphorusPct Float?
  vitamins      String?
  meKcalPerKg   Float?

  /// Default purchase price, used to cost a batch when a delivery does not
  /// record its own price. Actual cost per batch wins where present.
  costPerKgCents Int?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  storageRequirements String?
  /// Total remaining kg across batches below this raises a reorder alert.
  reorderLevelKg      Float   @default(0)
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches         FeedBatch[]
  feedingRecords  FeedingRecord[]
  feedingPrograms FeedingProgram[]

  @@unique([farmId, name])
  @@index([farmId, classification])
}

model FeedStorageLocation {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name       String
  capacityKg Float?
  notes      String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())

  batches FeedBatch[]

  @@unique([farmId, name])
}

/// One delivery of one feed type. FIFO consumption draws down `remainingKg`
/// oldest-batch-first (see src/lib/db/feed.ts), which is both correct for
/// perishable feed and what makes "which batch did this pen eat" answerable.
model FeedBatch {
  id         String   @id @default(cuid())
  feedTypeId String
  feedType   FeedType @relation(fields: [feedTypeId], references: [id], onDelete: Cascade)

  batchCode         String
  supplierLotNumber String?
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  receivedDate   DateTime
  expirationDate DateTime?
  quantityKg     Float
  remainingKg    Float
  costPerKgCents Int

  storageLocationId String?
  storageLocation   FeedStorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)

  nutritionalAnalysis String?
  qualityNotes        String?

  receivedByProfileId String?
  receivedBy          Profile? @relation("FeedBatchReceivedBy", fields: [receivedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedingRecords FeedingRecord[]

  @@index([feedTypeId, receivedDate])
  @@index([expirationDate])
}

/// A standing ration: "animals at this stage get this much of this feed a day".
model FeedingProgram {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name       String
  speciesId  String?
  species    Species?  @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  stage      LifeStage
  feedTypeId String
  feedType   FeedType  @relation(fields: [feedTypeId], references: [id], onDelete: Cascade)

  dailyKgPerAnimal Float
  ageDaysMin       Int?
  ageDaysMax       Int?
  /// Optional per-kg-bodyweight rule, used in preference to the flat daily
  /// figure when set (e.g. 0.04 = 4% of bodyweight per day).
  pctOfBodyweight  Float?
  notes            String?
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([farmId, name])
  @@index([farmId, stage])
}

/// A feeding event, recorded either for a whole pen or one animal. Pen-level is
/// the normal case on a real farm; individual records exist for animals under
/// observation. Cost allocation splits a pen record across its occupants.
model FeedingRecord {
  /// Feed given to a whole batch — a house of broilers or a pond of catfish.
  batchId String?
  batch   AnimalBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  id      String       @id @default(cuid())
  farmId  String
  farm    Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)

  fedAt DateTime

  penId       String?
  pen         Pen?    @relation(fields: [penId], references: [id], onDelete: SetNull)
  animalId    String?
  animal      Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)
  /// Number of animals the allocation covered, captured at feeding time so
  /// historical cost-per-animal doesn't shift as animals move between pens.
  animalCount Int     @default(1)

  feedTypeId  String
  feedType    FeedType   @relation(fields: [feedTypeId], references: [id], onDelete: Cascade)
  feedBatchId String?
  feedBatch   FeedBatch? @relation(fields: [feedBatchId], references: [id], onDelete: SetNull)

  allocatedKg    Float
  consumedKg     Float?
  /// Snapshot of the batch price so feed cost is stable once recorded.
  costPerKgCents Int?
  notes          String?

  recordedByProfileId String?
  recordedBy          Profile? @relation("FeedingRecordRecordedBy", fields: [recordedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([farmId, fedAt])
  @@index([penId, fedAt])
  @@index([animalId, fedAt])
  @@index([feedBatchId])
}

// ---------------------------------------------------------------------------
// Financial
// ---------------------------------------------------------------------------

/// The general ledger. Feed deliveries, health treatments and animal sales all
/// write a row here in the same transaction as their own record, so the P&L is
/// never assembled by re-deriving money from four different modules.
model FinancialTransaction {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  occurredAt  DateTime
  direction   TransactionDirection
  category    TransactionCategory
  amountCents Int
  description String?

  // Optional provenance links — set when a row was generated by another
  // module, null for manually entered costs like labour or utilities.
  animalId       String?
  animal         Animal?     @relation(fields: [animalId], references: [id], onDelete: SetNull)
  feedBatchId    String?
  healthRecordId String?
  animalSaleId   String?
  animalSale     AnimalSale? @relation(fields: [animalSaleId], references: [id], onDelete: SetNull)
  equipmentId    String?

  createdByProfileId String?
  createdBy          Profile? @relation("TransactionCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([farmId, occurredAt])
  @@index([farmId, direction, occurredAt])
  @@index([farmId, category, occurredAt])
  @@index([animalId])
}

model AnimalSale {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  soldAt       DateTime
  saleType     AnimalSaleType
  buyerName    String
  buyerContact String?
  notes        String?
  totalCents   Int

  createdByProfileId String?
  createdBy          Profile? @relation("AnimalSaleCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  items        AnimalSaleItem[]
  transactions FinancialTransaction[]

  @@index([farmId, soldAt])
}

model AnimalSaleItem {
  id     String     @id @default(cuid())
  saleId String
  sale   AnimalSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  weightKg        Float
  pricePerKgCents Int
  amountCents     Int
  carcassGrade    String?

  @@unique([saleId, animalId])
  @@index([animalId])
}

// ---------------------------------------------------------------------------
// Equipment & assets
// ---------------------------------------------------------------------------

model Equipment {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name               String
  category           String
  serialNumber       String?
  location           String?
  purchaseDate       DateTime?
  purchaseCostCents  Int?
  /// Drives straight-line depreciation and the age-based replacement alert.
  expectedLifeMonths Int?
  status             EquipmentStatus @default(IN_SERVICE)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceRecords MaintenanceRecord[]

  @@index([farmId, status])
}

model MaintenanceRecord {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  performedAt     DateTime
  maintenanceType MaintenanceType
  description     String
  costCents       Int             @default(0)
  nextDueAt       DateTime?

  createdByProfileId String?
  createdBy          Profile? @relation("MaintenanceRecordCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([equipmentId, performedAt])
  @@index([nextDueAt])
}

// ---------------------------------------------------------------------------
// Alerts & audit
// ---------------------------------------------------------------------------

/// Alerts themselves are *derived*, not stored: they are computed from live
/// data on each dashboard load (src/lib/alerts/*). A persisted alerts table
/// goes stale the moment the underlying condition changes — a sow flagged
/// "overdue" stays flagged after she farrows unless something remembers to
/// clear the row. What genuinely needs persisting is the human decision to
/// dismiss one, which is what this table holds. `alertKey` is the stable
/// identity of a computed alert (e.g. "overdue-farrowing:<breedingRecordId>").
model AlertAcknowledgement {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  alertKey     String
  note         String?
  /// Dismissals can be temporary — past this instant the alert resurfaces.
  snoozedUntil DateTime?

  acknowledgedByProfileId String?
  acknowledgedBy          Profile? @relation("AlertAckBy", fields: [acknowledgedByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([farmId, alertKey])
  @@index([farmId])
}

model AuditLog {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  profileId String?
  profile   Profile? @relation("AuditLogActor", fields: [profileId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String?
  summary    String?
  actorName  String?
  actorEmail String?

  createdAt DateTime @default(now())

  @@index([farmId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Species
// ---------------------------------------------------------------------------

/// A species the farm keeps, with the biology that drives every date the app
/// projects.
///
/// These were constants when the system handled pigs only. They are rows now
/// because they are facts about the animal, not preferences of the farm: a
/// goat gestates for 150 days whoever owns her. Getting one wrong quietly
/// misdates every farrowing, weaning and heat prediction for that species,
/// which is why the seeded defaults carry their real-world figures and the
/// farm can correct them without a deploy.
model Species {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name         String
  /// Stable short code used in tag prefixes, e.g. "PIG", "GOA", "BRO".
  code         String
  trackingMode TrackingMode   @default(INDIVIDUAL)
  purpose      SpeciesPurpose @default(LIVESTOCK)
  isActive     Boolean        @default(true)

  // --- Reproduction -----------------------------------------------------
  /// Days from mating to birth. For egg-laying species this is the incubation
  /// period instead; null where the concept does not apply (fish, snails).
  gestationDays            Int?
  gestationToleranceDays   Int    @default(3)
  estrusCycleDays          Int?
  weaningAgeDays           Int?
  minBreedingAgeDaysFemale Int?
  minBreedingAgeDaysMale   Int?
  minBreedingWeightKg      Float?
  /// Typical number born per birth, used to sanity-check entered litter sizes.
  typicalLitterSize        Int?

  /// False for hermaphrodites — snails have no sex to record, and demanding
  /// one would make every snail row carry a meaningless required field.
  hasSex         Boolean @default(true)
  /// False where pedigree is not tracked, which is most batch species.
  tracksPedigree Boolean @default(true)

  // --- Terminology ------------------------------------------------------
  // Farmers do not say "the pig gave birth". Using the right word is the
  // difference between software that reads as though it knows the job and
  // software that reads as though it was written by someone who does not.
  birthEventTerm  String @default("birth") // farrowing, kidding, lambing
  youngTerm       String @default("young") // piglet, kid, lamb, calf
  adultFemaleTerm String @default("female") // sow, doe, ewe, cow
  adultMaleTerm   String @default("male") // boar, buck, ram, bull
  groupTerm       String @default("group") // herd, flock, colony

  /// Upper bound of the body condition scale — 5 for pigs and goats, 9 for
  /// cattle. Scoring a cow on the pig scale is not a rounding error.
  bodyConditionScaleMax Int @default(5)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animals         Animal[]
  batches         AnimalBatch[]
  feedingPrograms FeedingProgram[]
  protocolItems   VaccinationProtocolItem[]

  @@unique([farmId, name])
  @@unique([farmId, code])
  @@index([farmId, trackingMode])
}

// ---------------------------------------------------------------------------
// Batches — flock, pond and colony animals
// ---------------------------------------------------------------------------

/// A group of animals stocked, fed and sold together: a house of broilers, a
/// pond of catfish, a pen of snails.
///
/// `currentCount` is denormalised from the event log rather than derived on
/// every read. The log in `BatchEvent` is the authority — this column is a
/// cache kept in the same transaction as the event that changes it, because
/// "how many birds are alive right now" is asked on every list screen and
/// summing a year of mortality rows to answer it would be absurd.
model AnimalBatch {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  speciesId String
  species   Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  /// Human name, e.g. "Broiler house 2 — Aug intake".
  name      String
  batchCode String

  penId String?
  pen   Pen?    @relation(fields: [penId], references: [id], onDelete: SetNull)

  status BatchStatus @default(ACTIVE)

  startDate    DateTime
  /// Age of the stock on arrival: day-olds are 0, point-of-lay pullets ~112.
  startAgeDays Int       @default(0)
  endDate      DateTime?

  initialCount Int
  currentCount Int

  /// Where the stock came from — hatchery, supplier, own breeding.
  source               String?
  acquisitionCostCents Int?

  /// Latest sampled average weight, for growth and FCR without weighing
  /// every animal.
  avgWeightKg Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events            BatchEvent[]
  productionRecords BatchProductionRecord[]
  feedingRecords    FeedingRecord[]
  healthRecords     HealthRecord[]

  @@unique([farmId, batchCode])
  @@index([farmId, status])
  @@index([speciesId])
  @@index([penId])
}

/// Every change to a batch's headcount or weight. Append-only: the running
/// count is rebuilt from here if it ever disagrees with the cached column.
model BatchEvent {
  id      String      @id @default(cuid())
  batchId String
  batch   AnimalBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  eventType  BatchEventType
  occurredAt DateTime
  /// Head count affected. Zero for a weight sample.
  quantity   Int            @default(0)
  /// Average weight in kg for a WEIGHT_SAMPLE, or per-animal weight at sale.
  weightKg   Float?
  /// Cause of death or reason for the cull — the field that turns a mortality
  /// figure into something you can act on.
  reason     String?
  notes      String?

  createdByProfileId String?
  createdBy          Profile? @relation("BatchEventCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([batchId, occurredAt])
  @@index([eventType])
}

/// Ongoing output from a batch — eggs from layers, milk, snail slime. Distinct
/// from a sale: this is production, which may be sold later or consumed.
model BatchProductionRecord {
  id      String      @id @default(cuid())
  batchId String
  batch   AnimalBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  productionType   BatchProductionType @default(EGGS)
  collectedAt      DateTime
  /// Eggs collected, litres of milk, kg of whatever the species yields.
  quantity         Float
  unit             String              @default("count")
  /// Cracked, dirty or otherwise unsellable — lay percentage should be read
  /// against total, but revenue only against saleable.
  rejectedQuantity Float               @default(0)
  notes            String?

  createdByProfileId String?
  createdBy          Profile? @relation("BatchProductionCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([batchId, collectedAt])
}

/// Throttling for the unauthenticated endpoints — sign-in, sign-up and
/// password reset.
///
/// Stored rather than held in memory because the app runs serverless: an
/// in-process counter is per-instance and per-cold-start, so an attacker gets
/// a fresh allowance with every new lambda. A row per attempt makes the window
/// a plain query, and old rows are pruned opportunistically on write.
///
/// The key is deliberately opaque — a hash of the identifier, never the email
/// itself. A table of every address that has ever attempted a login is a
/// disclosure risk in its own right, and this table has no business holding
/// one.
model AuthAttempt {
  id String @id @default(cuid())

  /// SHA-256 of the scope plus the identifier (email or client address).
  keyHash     String
  scope       String
  attemptedAt DateTime @default(now())
  /// False for a failed attempt. Successes are recorded too, so a correct
  /// password does not silently reset an attacker's budget.
  succeeded   Boolean  @default(false)

  @@index([keyHash, attemptedAt])
  @@index([attemptedAt])
}

/// An invitation for someone to join a specific farm.
///
/// Open signup creates a *new* farm for whoever signs up — this is how an
/// existing farm adds its own staff instead. Without it the two cases are
/// indistinguishable, and a SaaS cannot tell "I am starting a farm" apart
/// from "I work at one that already exists".
///
/// Only a hash of the token is stored. The plaintext goes in the invite link
/// and is never persisted, so a leaked database does not hand over working
/// invitations to every farm on the platform.
model FarmInvite {
  id     String @id @default(cuid())
  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  email     String
  role      Role   @default(WORKER)
  tokenHash String @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdByProfileId String?
  createdBy          Profile? @relation("FarmInviteCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([farmId, acceptedAt])
  @@index([email])
}
